{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run migrate && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/cron/overdue-tasks",
      "destination": "/api/cron/overdue-tasks"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/overdue-tasks",
      "schedule": "0 3 * * *"
    }
  ]
}
