{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run migrate",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/cron/overdue-tasks",
      "destination": "/api/cron/overdue-tasks"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/overdue-tasks",
      "schedule": "0 3 * * *"
    }
  ]
}
