# PostgreSQL / Neon Database Connection String (Backend Secret)
DATABASE_URL="postgres://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"

# JWT Signing Secret Key (Backend Secret, Minimum 32 characters in production)
JWT_SECRET="your-high-entropy-jwt-secret-key-here"

# Vercel Cron Invocation Secret (Backend Secret)
CRON_SECRET="your-random-cron-secret-token-here"

# Optional SMTP Email Configuration (Backend Config & Secrets)
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT=587
SMTP_USER="notifications@company.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="INDIGO TEAM <notifications@company.com>"
SMTP_SECURE="false"

# Initial Bootstrap Admin Credentials (Used by seed script)
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASS="admin123"

# Port (used for standalone/local development)
PORT=3000
